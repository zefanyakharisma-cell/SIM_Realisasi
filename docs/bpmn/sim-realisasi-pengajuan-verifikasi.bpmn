<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Process_sim_realisasi_pengajuan_verifikasi" targetNamespace="https://petra.ac.id/sim-realisasi/bpmn" exporter="SIM Realisasi docs/bpmn/generate.py" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_Process_sim_realisasi_pengajuan_verifikasi">
    <bpmn:participant id="Participant_main" name="SIM Realisasi: Pengajuan &amp; Verifikasi Kegiatan" processRef="Process_sim_realisasi_pengajuan_verifikasi" />
    <bpmn:participant id="pool_simks" name="SIM Kerjasama" />
    <bpmn:participant id="pool_baak" name="BAAK &amp; HR (data mahasiswa / pegawai)" />
    <bpmn:messageFlow id="mf_docs" name="Dokumen MoU/MoA berlaku pada tanggal kegiatan" sourceRef="pool_simks" targetRef="t_detail" />
    <bpmn:messageFlow id="mf_lookup" name="Cek NRP / NIP" sourceRef="t_lookup" targetRef="pool_baak" />
    <bpmn:messageFlow id="mf_realisasi" name="Tab Realisasi &amp; flag tanpa realisasi" sourceRef="t_count" targetRef="pool_simks" />
  </bpmn:collaboration>
  <bpmn:process id="Process_sim_realisasi_pengajuan_verifikasi" name="Pengajuan &amp; Verifikasi Kegiatan" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="lane_unit" name="Unit Akademik (Pengaju)">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_detail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_mob</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_files</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_peserta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_files_mob</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_m1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_revise</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_mob" name="Tim Mobilitas IO">
        <bpmn:flowNodeRef>t_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_dup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_m2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_revise_req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_approve</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_sys" name="SIM Realisasi (Sistem)">
        <bpmn:flowNodeRef>t_draft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_lookup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_track</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_auto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_pending</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_verified</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_m3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_count</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Kegiatan kerja sama selesai dilaksanakan">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="t_detail" name="Isi Detail kegiatan &amp; pilih Kerja Sama">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="t_draft" name="Simpan draf; tetapkan semester/TA &amp; batas lapor">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g_mob" name="Kegiatan mobilitas?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t_files" name="Unggah IA &amp; IR (PDF) + bukti opsional">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t_peserta" name="Isi peserta (NRP mahasiswa, NIP pegawai, inbound)">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="t_lookup" name="Lookup NRP/NIP ke data BAAK &amp; HR">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g_valid" name="Semua NRP/NIP ditemukan?">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t_files_mob" name="Unggah IA, IR &amp; PDF mobilitas (gabungan)">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g_m1" name="">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t_submit" name="Ajukan kegiatan">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="t_validate" name="Validasi pengajuan; tandai Terlambat bila lewat batas">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g_track" name="Jenis = kegiatan mobilitas?">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t_auto" name="Status Terverifikasi (track not_required)">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="t_pending" name="Track Mobilitas = pending; deteksi duplikat mahasiswa; notifikasi">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:incoming>Flow_27</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="t_review" name="Tinjau peserta &amp; PDF mobilitas">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g_dup" name="Ada duplikat mahasiswa antar-unit?">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t_decide" name="Pilih kegiatan yang mempertahankan mahasiswa">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g_m2" name="">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="g_ok" name="Peserta &amp; berkas sesuai?">
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t_revise_req" name="Minta revisi (catatan wajib)">
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t_revise" name="Perbaiki &amp; ajukan ulang (versi peserta n+1)">
      <bpmn:incoming>Flow_26</bpmn:incoming>
      <bpmn:outgoing>Flow_27</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t_approve" name="Setujui versi peserta">
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:outgoing>Flow_28</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="t_verified" name="Status Terverifikasi; catat verified_at; notifikasi unit">
      <bpmn:incoming>Flow_28</bpmn:incoming>
      <bpmn:outgoing>Flow_29</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="g_m3" name="">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:incoming>Flow_29</bpmn:incoming>
      <bpmn:outgoing>Flow_30</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t_count" name="Hitung ke RENSTRA per unit &amp; International Awards">
      <bpmn:incoming>Flow_30</bpmn:incoming>
      <bpmn:outgoing>Flow_31</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end" name="Kegiatan terverifikasi &amp; terhitung">
      <bpmn:incoming>Flow_31</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="start" targetRef="t_detail" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="t_detail" targetRef="t_draft" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="t_draft" targetRef="g_mob" />
    <bpmn:sequenceFlow id="Flow_4" name="Tidak" sourceRef="g_mob" targetRef="t_files" />
    <bpmn:sequenceFlow id="Flow_5" name="Ya" sourceRef="g_mob" targetRef="t_peserta" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="t_peserta" targetRef="t_lookup" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="t_lookup" targetRef="g_valid" />
    <bpmn:sequenceFlow id="Flow_8" name="Tidak" sourceRef="g_valid" targetRef="t_peserta" />
    <bpmn:sequenceFlow id="Flow_9" name="Ya" sourceRef="g_valid" targetRef="t_files_mob" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="t_files" targetRef="g_m1" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="t_files_mob" targetRef="g_m1" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="g_m1" targetRef="t_submit" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="t_submit" targetRef="t_validate" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="t_validate" targetRef="g_track" />
    <bpmn:sequenceFlow id="Flow_15" name="Ya" sourceRef="g_track" targetRef="t_pending" />
    <bpmn:sequenceFlow id="Flow_16" name="Tidak" sourceRef="g_track" targetRef="t_auto" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="t_auto" targetRef="g_m3" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="t_pending" targetRef="t_review" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="t_review" targetRef="g_dup" />
    <bpmn:sequenceFlow id="Flow_20" name="Ya" sourceRef="g_dup" targetRef="t_decide" />
    <bpmn:sequenceFlow id="Flow_21" name="Tidak" sourceRef="g_dup" targetRef="g_m2" />
    <bpmn:sequenceFlow id="Flow_22" sourceRef="t_decide" targetRef="g_m2" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="g_m2" targetRef="g_ok" />
    <bpmn:sequenceFlow id="Flow_24" name="Tidak" sourceRef="g_ok" targetRef="t_revise_req" />
    <bpmn:sequenceFlow id="Flow_25" name="Ya" sourceRef="g_ok" targetRef="t_approve" />
    <bpmn:sequenceFlow id="Flow_26" sourceRef="t_revise_req" targetRef="t_revise" />
    <bpmn:sequenceFlow id="Flow_27" sourceRef="t_revise" targetRef="t_pending" />
    <bpmn:sequenceFlow id="Flow_28" sourceRef="t_approve" targetRef="t_verified" />
    <bpmn:sequenceFlow id="Flow_29" sourceRef="t_verified" targetRef="g_m3" />
    <bpmn:sequenceFlow id="Flow_30" sourceRef="g_m3" targetRef="t_count" />
    <bpmn:sequenceFlow id="Flow_31" sourceRef="t_count" targetRef="end" />
    <bpmn:textAnnotation id="note_draft"><bpmn:text>Draf boleh dihapus hanya oleh pembuatnya atau IO Admin; kegiatan yang sudah diajukan tidak pernah dihapus (R-15)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="note_draft_assoc" sourceRef="note_draft" targetRef="t_draft" />
    <bpmn:textAnnotation id="note_count"><bpmn:text>Dihitung per unit: Fakultas = kegiatan sendiri + Program Studi + Program. Awards hanya memeringkat Program Studi (R-48)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="note_count_assoc" sourceRef="note_count" targetRef="t_count" />
  </bpmn:process>
