# Copy to .env.local (gitignored). Server code connects with postgres.js; RLS is applied via `set local role authenticated`.

# Supabase project (simks-partnership). The publishable key is safe in the browser; the app does not need it yet
# (no supabase-js client), it is kept for Supabase Auth/Storage later.
NEXT_PUBLIC_SUPABASE_URL=https://cmvmukexzmmagupbndmx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Postgres the app talks to.
#  - local Supabase CLI / plain Postgres:  postgresql://postgres:postgres@127.0.0.1:54322/postgres
#    (run `npm run db:reset` once; it refuses to touch a database that holds real SIM Kerjasama tables)
#  - hosted project (Vercel): TRANSACTION pooler, port 6543. The session pooler (5432) pins one of its 15 server
#    connections per open client, and serverless instances keep idle sockets open, so it runs out
#    (EMAXCONNSESSION, 2026-10-05). The app is transaction-mode safe: prepare:false, one transaction per withUser.
#    postgresql://postgres.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# Optional: connections per server instance (default 3 on Vercel, 10 locally).
# DB_POOL_MAX=3
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Demo role switcher on the login page (mockup only). Set 0 to disable.
DEMO_AUTH=1

# Deploy target for scripts/db-deploy-supabase.sh (DDL in one long transaction: session pooler 5432 or the direct
# connection, never 6543) — set as an environment secret, never commit.
# SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
