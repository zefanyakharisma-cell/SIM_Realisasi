# Postgres 16 (plain or Supabase). postgres.js connects directly; RLS is applied via `set local role authenticated`.
DATABASE_URL=postgresql://postgres@localhost:54322/sim_realisasi
# Demo role switcher on the login page (mockup only). Set 0 to disable.
DEMO_AUTH=1
# Supabase deploy target (session pooler, port 5432) for scripts/db-deploy-supabase.sh — set as an env secret, never commit.
# SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
